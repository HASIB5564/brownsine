function setCookie(name,value,time,path,domain,secure){var date;if(time){date=new Date();date.setTime(date.getTime()+(time*1000));}document.cookie=name+"="+escape(value)+((time)?"; expires="+date.toGMTString():"")+((path)?"; path="+path:"")+((domain)?"; domain="+domain:"")+((secure)?"; secure":"");}function getCookie(name){var prefix=name+"=";var si=document.cookie.indexOf(prefix);if(si==-1)return null;var ei=document.cookie.indexOf(";",si+prefix.length);if(ei==-1)ei=document.cookie.length;return unescape(document.cookie.substring(si+prefix.length,ei));}function deleteCookie(name){document.cookie=name+"=;path=/; expires=Fri, 31 Dec 1999 23:59:59 GMT;";}function isCookiesSupported(){setCookie('TestCookie',100,365*24*60*60);if(getCookie('TestCookie')!=100)return false;deleteCookie('TestCookie');return true;}function getCookiesArrayElement(arrayName,index){return getCookie(arrayName+'['+index+']');}function setCookiesArrayElement(arrayName,index,value,time,path,domain,secure){setCookie(arrayName+'['+index+']',value,time,path,domain,secure);}function deleteCookiesArrayElement(arrayName,index){return deleteCookie(arrayName+'['+index+']');}function getCookiesArraySize(name){var s=0;var cookies=document.cookie.split("; ");for(var i=0;i<cookies.length;i++){var name_value=cookies[i].split("=");if(name_value[0].indexOf(name+'[')!=-1)s++;}return s;}function getCookiesArrayIndexes(name){var indexes=new Array();var cookies=document.cookie.split("; ");for(var i=0;i<cookies.length;i++){var name_value=cookies[i].split("=");if(name_value[0].indexOf(name+'[')!=-1)indexes.push(name_value[0].replace(name+'[','').replace(']',''));}return indexes;}function findInCookiesArray(arrayName,value){value=escape(value);var cookies=document.cookie.split("; ");for(var i=0;i<cookies.length;i++){var name_value=cookies[i].split("=");if((value==name_value[1])&&(name_value[0].indexOf(arrayName+'[')!=-1)){var s=name_value[0].replace(arrayName+'[','');return s.replace(']','');}}return null;}function deleteCookiesArray(name){var cookies=document.cookie.split("; ");for(var i=0;i<cookies.length;i++){var name_value=cookies[i].split("=");if(name_value[0].indexOf(name+'[')!=-1)document.cookie=name_value[0]+"=;path=/; expires=Fri, 31 Dec 1999 23:59:59 GMT;";}}function deleteCookiesSubArrayByVal(name,val){var indexes=new Array();var cookies=document.cookie.split("; ");for(var i=0;i<cookies.length;i++){var name_value=cookies[i].split("=");if((name_value[0].indexOf(name+'[')!=-1)&&(name_value[1]==val))deleteCookie(name_value[0]);}return 1;}